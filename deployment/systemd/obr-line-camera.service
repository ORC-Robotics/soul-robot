[Unit]
Description=OBR 2026 Line Camera and Vision
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
User=raspberry
SupplementaryGroups=gpio
WorkingDirectory=/home/raspberry/OBR2026K
ExecStart=/home/raspberry/OBR2026K/scripts/run_line_camera.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
