# Dataset e resultados do classificador Silver legado.
dataset/
training_outputs/

# Dados capturados, anotados e preparados para o YOLO.
# Scripts, documentação e data.yaml continuam versionáveis.
yolo_ball/datasets/images/raw/
yolo_ball/datasets/annotated/
yolo_ball/datasets/train/images/
yolo_ball/datasets/train/labels/
yolo_ball/datasets/valid/images/
