{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Deploy Raspberry",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/deployment/deploy.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Deploy only Raspberry",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/deployment/deploy.ps1",
                "-NoRun"
            ],
            "problemMatcher": []
        },
        {
            "label": "Open Deploy Button",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/deployment/deploy_panel.py"
            ],
            "problemMatcher": []
        }
    ]
}
